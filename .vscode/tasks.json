{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dev",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": [
				"$tsc-watch"
			],
			"group": "build"
		},
		{
			"label": "build",
			"type": "shell",
			"command": "npm run build",
			"problemMatcher": [
				"$tsc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "test",
			"type": "shell",
			"command": "npm test",
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "prisma:studio",
			"type": "shell",
			"command": "npx prisma studio",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}