# ─── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to packages/db)
DATABASE_URL="file:./dev.db"

# ─── JWT (apps/api) ──────────────────────────────────────────────────────────
# Secret key used to sign JWT access tokens. Must be at least 32 characters.
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-characters"

# Access token lifetime (e.g. 15m, 1h). Refresh tokens are always 30 days.
JWT_ACCESS_EXPIRES_IN="15m"

# ─── Steam ───────────────────────────────────────────────────────────────────
# Your Steam Web API key from https://steamcommunity.com/dev/apikey
# REQUIRED for Steam login, friends and owned-games features.
# Example: STEAM_API_KEY="0123456789ABCDEF0123456789ABCDEF"
STEAM_API_KEY=""

# Public base URL of the API server (used as OpenID realm and callback base)
# Example: https://api.yourdomain.com
STEAM_REALM="http://localhost:3010"

# ─── Server (apps/api) ───────────────────────────────────────────────────────
PORT=3010

# URL of the Next.js frontend (used for CORS and post-login redirects)
FRONTEND_URL="http://localhost:3000"

# Set to "true" in production to mark cookies as Secure
COOKIE_SECURE="false"

# ─── Frontend (apps/web) ─────────────────────────────────────────────────────
# The public URL of the Fastify API server (accessible from the browser)
# Update this to match the API `PORT` if you change it (default: 3010)
NEXT_PUBLIC_API_URL="http://localhost:3010"
