{
  "name": "steam-auction",
  "private": true,
  "packageManager": "npm@11.12.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "postinstall": "npm rebuild lightningcss @tailwindcss/oxide --workspace=apps/web || true",
    "build": "turbo run build --filter=!@steam-auction/desktop && npm run build --workspace=apps/desktop",
    "test": "turbo run test",
    "test:unit": "npm test --workspace=packages/shared && npm test --workspace=packages/api-client && npm test --workspace=apps/api && npm test --workspace=apps/web",
    "lint": "turbo run lint",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:studio": "npm run studio --workspace=packages/db"
  },
  "devDependencies": {
    "turbo": "^2.8.20",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}